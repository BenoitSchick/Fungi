		(uuid "5aaaccba-d76b-4ea2-8114-3d45b786ff24")
	)
	(text "The maximum continuous junction temperature T_J(max) must stay under 125°C\nT_J(max) = P_LDO * Rtheta_JA + Tambiant = 0.02W * 41.0°C/W + 60°C = 60.7°C"
		(exclude_from_sim no)
