	)
	(text "For 3x3DFN package, the maximum package power dissipation at 60°C ambiant temperature is :\nP_D(max) = (125°C - 60°C) / 41°C/W = 1.585W"
		(exclude_from_sim no)
		(at 75.946 69.088 0)
